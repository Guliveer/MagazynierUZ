# hCaptcha Configuration
# Get your site key from https://dashboard.hcaptcha.com/
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key_here

# hCaptcha Secret Key (for server-side verification)
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret_key_here

# Backend config
NEXT_PUBLIC_BACKEND_HOST=http://localhost:8080

# Encryption Configuration
# Secret key used for client-side credential encryption
#
# SECURITY CONSIDERATIONS:
# - This is CLIENT-SIDE encryption - the secret is exposed in the browser bundle
# - Provides obfuscation, not true security against determined attackers
# - Suitable for preventing casual inspection of sessionStorage
# - For production, use a strong, unique secret (minimum 32 characters)
#
# HOW TO GENERATE A SECURE SECRET:
# Option 1 - Using Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Option 2 - Using OpenSSL:
#   openssl rand -base64 32
#
# Option 3 - Using online generator (use with caution):
#   Visit: https://www.random.org/strings/?num=1&len=32&digits=on&upperalpha=on&loweralpha=on&unique=on&format=plain
#
# Option 4 - Using pwgen (if installed):
#   pwgen -s 32 1
#
# IMPORTANT:
# - Keep this secret consistent across deployments to maintain access to encrypted data
# - Changing this secret will invalidate all previously encrypted credentials
# - Store this securely in your deployment environment (Vercel, AWS, etc.)
# - Never commit the actual secret to version control
NEXT_PUBLIC_ENCRYPTION_SECRET=your_encryption_secret_here_minimum_32_characters_recommended
